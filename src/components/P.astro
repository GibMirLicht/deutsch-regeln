---
/** A paragraph of German text with its translations below it. */
import Tr from './Tr.astro';
import { assertTranslation } from '../lib/i18n.ts';
import { inline } from '../lib/inline.ts';

interface Props {
  t: unknown;
}
const { t } = Astro.props;
assertTranslation(t, `<P> in ${Astro.url.pathname}`);
---
<div class="bi">
  <p class="de" lang="de" set:html={inline(t.de)} />
  <Tr t={t} as="p" />
</div>
