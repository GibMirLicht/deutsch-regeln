---
/** Lists the direct children of the current article in tree order (stand-in until the tree view, PLAN stage 4). */
import { getCollection } from 'astro:content';

const current = Astro.locals.starlightRoute.entry.id;
const prefix = current === '' ? '' : `${current}/`;
const children = (await getCollection('docs'))
  .filter((e) => e.data.kind === 'article' && e.id.startsWith(prefix) && !e.id.slice(prefix.length).includes('/') && e.id !== current)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<ul class="children">
  {children.map((e) => <li><a href={`${base}/${e.id}/`}>{e.data.title}</a></li>)}
</ul>
